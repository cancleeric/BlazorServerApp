{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "EnterpriseIDS": "Debug"
    }
  },
  
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=enterpriseids-dev.db"
  },

  "JwtTokenSettings": {
    "Issuer": "EnterpriseIdentityServer-Dev",
    "Audience": "EnterpriseIDS-Dev",
    "SecretKey": "ThisIsADevelopmentSecretKeyForHMACSigningMustBeAtLeast256Bits",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30,
    "ClockSkewMinutes": 10,
    "EnableRefreshTokenRotation": false
  },
  
  "Authentication": {
    "RequireHttpsMetadata": false,
    "SaveToken": true
  }
}