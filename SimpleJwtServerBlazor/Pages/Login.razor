@page "/login"
@using BlazorAuthSdk.Services
@using BlazorAuthSdk.Models
@inject BlazorAuthSdk.Services.IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>登入 - SimpleJwtServerBlazor</PageTitle>

<h3>JWT 登入</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <InputText @bind-Value="loginModel.Username" placeholder="帳號" class="form-control mb-2" />
    <InputText @bind-Value="loginModel.Password" placeholder="密碼" type="password" class="form-control mb-2" />
    <button class="btn btn-primary" type="submit">登入</button>
</EditForm>

@code {
    private BlazorAuthSdk.Models.LoginRequest loginModel = new();
    private string? errorMessage;

    private void HandleLogin()
    {
        // Initiate login by redirecting to AuthenticationServer
        AuthService.InitiateLogin();
    }
}