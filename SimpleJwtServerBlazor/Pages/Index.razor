@using Microsoft.AspNetCore.Components.Authorization
@using BlazorAuthSdk.Services
@inject BlazorAuthSdk.Services.IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>首頁</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>歡迎，@context.User.Identity?.Name！</h3>
        <button class="btn btn-secondary" @onclick="Logout">登出</button>
    </Authorized>
    <NotAuthorized>
        <h3>您尚未登入</h3>
        <a class="btn btn-primary" href="/login">前往登入</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}